{
  "name": "management-system-desktop",
  "productName": "Management System",
  "version": "1.0.0",
  "description": "Ứng dụng máy tính cho Management System – The Jungle Herbs",
  "author": "The Jungle Herbs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thejungleherbs.management",
    "productName": "Management System",
    "artifactName": "Management-System-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "app-config.json", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Management System" },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.business", "identity": null },
    "dmg": { "title": "Management System" }
  }
}
